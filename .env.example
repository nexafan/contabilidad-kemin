# =============================================================================
# Panel KEMIN — variables de entorno
# Copia este archivo a `.env` y rellena los valores. NUNCA commitees `.env`.
# =============================================================================

# Puerto del servidor
# OJO: en el VPS Hetzner 37.27.216.31, 4123 = panel NexaFans contable,
# 4124 = panel NexaFans reclutamiento. KEMIN usa 4125 por defecto.
PORT=4125

# Llave del panel. NO hay usuario ni contraseña: la protección es el enlace.
# Se entra una vez a  https://TU-DOMINIO/k/<PANEL_TOKEN>  y el navegador queda
# recordado un año. Quien no tenga el enlace recibe un 404 seco.
# Genera uno nuevo con:   openssl rand -hex 24
# Mínimo 24 caracteres; si falta, el panel NO arranca (para no quedar abierto).
# Si se filtra el enlace o se pierde un móvil: cambia este valor y reinicia
# (`pm2 restart contabilidad-kemin`); todos los enlaces viejos dejan de valer.
PANEL_TOKEN=cambia_esto_por_una_cadena_larga_y_aleatoria

# Claude API (para OCR de capturas)
# Crea una key en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5

# DB
DB_PATH=./data/kemin.db

# Storage de capturas
UPLOADS_DIR=./uploads

# Umbral para que un evento aparezca como tab automática
EVENT_AUTO_TAB_THRESHOLD=40

# Cashback que devuelve el banco por cada compra (en decimal, 0.02 = 2%)
CASHBACK_RATE=0.02

# Backblaze B2 (opcional pero recomendado)
# Crea bucket privado + Application Key en https://secure.backblaze.com/app_keys.htm
# Si no lo configuras, el backup solo es local.
B2_ENABLED=false
# OJO: SIEMPRE con subcarpeta propia (bucket/carpeta), NUNCA solo el bucket.
# El backup hace `rclone sync`, que es un ESPEJO: apuntando a la raiz borra todo lo
# que no sea de KEMIN. El bucket lo comparte el backup de NexaFans (carpeta nexafans/)
# y apuntar aqui a la raiz le borro 6 dias de copias de contratos y cedulas (28-jul-2026).
B2_BUCKET=kemin-backups/kemin
B2_KEY_ID=
B2_APP_KEY=
B2_REGION=us-west-002
